<?xml version='1.0' ?>
<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="headless" default="false"/>
  <arg name="map_name" default="katong_office"/>

  <arg name="building_file" default="/home/saikham/rmf_ws/install/rmf_demos_maps/share/rmf_demos_maps/katong_office/katong_office.building.yaml"/>
 <arg name="nav_graph_dir" default="/home/saikham/rmf_ws/install/rmf_demos_maps/share/rmf_demos_maps/maps/katong_office/nav_graphs"/>
  <arg name="viz_config_file" default="/home/saikham/rmf_ws/install/rmf_demos_maps/share/rmf_demos_maps/maps/katong_office/katong_office.rviz"/>

  <node pkg="rmf_building_map_tools" exec="building_map_server" args="$(var building_file)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="rviz2" exec="rviz2" args="-d $(var viz_config_file)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
  
  <node pkg="tf2_ros" exec="static_transform_publisher" name="map_to_world" 
        args="0 0 0 0 0 0 map world">
    <param name="use_sim_time" value="true"/>
  </node>

  <include file="$(find-pkg-share rmf_demos_gz)/simulation.launch.xml">
    <arg name="map_name" value="$(var map_name)" />
    <arg name="headless" value="$(var headless)" />
    <arg name="use_sim_time" value="$(var use_sim_time)" />
  </include>
  
  <include file="$(find-pkg-share rmf_demos_fleet_adapter)/launch/fleet_adapter.launch.xml">
    <arg name="fleet_name" value="TinyRobot"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="nav_graph_file" value="$(var nav_graph_dir)/0.yaml"/>
    <arg name="config_file" value="/home/saikham/rmf_ws/src/rmf/rmf_demos/rmf_demos/config/katong_office/katong_office_config.yaml"/>
  </include>
  
  <include file="$(find-pkg-share rmf_demos_fleet_adapter)/launch/fleet_adapter.launch.xml">
    <arg name="fleet_name" value="CleanerBotA"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="nav_graph_file" value="$(var nav_graph_dir)/1.yaml"/>
    <arg name="config_file" value="/home/saikham/rmf_ws/src/rmf/rmf_demos/rmf_demos/config/katong_office/cleanerBotA_config.yaml"/>
  </include>

    <!-- Mock Docker Node, provides dock/clean path summary -->
  <group>
    <let name="docking_config_file" value="$(find-pkg-share rmf_demos_tasks)/katong_office_cleaner_config.yaml"/>
    <node pkg="rmf_demos_tasks" exec="mock_docker" args="-c $(var docking_config_file)">
      <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
  </group>
  
</launch>
